{
  "name": "@siddhartha/mcp-shield",
  "version": "0.1.0-alpha.0",
  "description": "Security middleware for MCP servers in one line.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ipaddr.js": "^2.2.0",
    "lru-cache": "^11.0.0",
    "shell-quote": "^1.8.1",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@changesets/cli": "^2.27.7",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@types/node": "^20.14.0",
    "@types/shell-quote": "^1.7.5",
    "@vitest/coverage-v8": "^2.0.0",
    "tsup": "^8.2.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}
